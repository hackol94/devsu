# Environment Configuration - Production
# Este archivo contiene las variables de ambiente para el entorno de producción

# ============================================
# URLs Base
# ============================================
# URL base de la aplicación web
BASEURL=https://prod.example.com

# URL base de la API REST
API_BASE_URL=https://api.example.com

# URL base de AppSync GraphQL
APPSYNC_BASE_URL=https://appsync.example.com

# ============================================
# API Paths
# ============================================
# Path para servicio de cifrado
CIPHER_PATH=/cipher

# Path para obtener clave pública del servicio de cifrado
path_cipher_public_key=/api/v1/cipher/publickey

# Path para servicio de autenticación
AUTH_PATH=/auth

# Path para servicio de cuentas
ACCOUNTS_PATH=/accounts

# Path para servicio de transacciones
TRANSACTIONS_PATH=/transactions

# Path para servicio de beneficiarios
BENEFICIARIES_PATH=/beneficiaries

# ============================================
# Feature Flags
# ============================================
# Habilitar header canary para ambiente beta
canary=false

# Habilitar sistema de mocks
mock=false

# Habilitar configuración de viewport personalizado
viewPort=false

# Ancho del viewport (solo si viewPort=true)
viewPort_width=1920

# Alto del viewport (solo si viewPort=true)
viewPort_height=1080

# Actualizar esquemas de mocks automáticamente
updateSchema=false

# Usar dispositivo LambdaTest para ejecución remota
ltDevice=true

# Agregar header x-api-key en las peticiones
apiKeyHeader=true

# ============================================
# Browser Configuration
# ============================================
# Navegador a utilizar: chrome_latest, firefox, Safari
BROWSER=chrome_latest

# ============================================
# LambdaTest Configuration
# ============================================
# Usuario de LambdaTest (requerido si ltDevice=true)
LT_USERNAME=your_lambdatest_username

# Access key de LambdaTest (requerido si ltDevice=true)
LT_ACCESS_KEY=your_lambdatest_access_key

# ============================================
# Cryptography Configuration
# ============================================
# Vector de inicialización para AES (16 caracteres)
aesInitialVector=1234567890123456

# Clave privada para encriptación
privateKey=your_private_key_here

# Clave pública (se obtiene dinámicamente de la API)
publicKey=

# ============================================
# API Keys and Headers
# ============================================
# API Key para servicios que lo requieren
API_KEY=your_api_key_here

# Serial del dispositivo para header x-device-serial
deviceSerial=

# ============================================
# SonarQube Configuration
# ============================================
# Organización en SonarQube
SONAR_ORGANIZATION=your_organization

# URL del servidor SonarQube
SONAR_URL=https://sonarcloud.io

# Token de autenticación SonarQube
SONAR_TOKEN=your_sonar_token_here

# ============================================
# ReqRes API
# ============================================
# API Key para reqres.in (requerida para endpoints demo)
REQRES_API_KEY=reqres_09d8a64a286647ffaf31e195d1061697

# ============================================
# Environment
# ============================================
# Ambiente actual (dev, stg, prod)
ENV=prod
