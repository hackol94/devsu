{
  "name": "devsu-qa-playwrigth-api-e2e",
  "version": "1.0.0",
  "description": "Framework skeleton de automatización E2E con Playwright + Cucumber",
  "main": "index.js",
  "scripts": {
    "pretest": "playwright install && ts-node src/helper/report/init.ts",
    "test": "cucumber-js --exit || exit 0",
    "posttest": "ts-node src/helper/report/postReport.ts",
    "test:login": "npm run test --TAGS=\"@TEST_TC-300\"",
    "test:crear-cliente": "npm run test --TAGS=\"@TEST_TC-200\"",
    "test:all": "npm run test --TAGS=\"@layer:Frontend or @API\"",
    "mergeReports": "ts-node src/helper/report/mergeReports.ts",
    "generate:merged:html": "ts-node src/helper/report/report.ts",
    "test:failed": "ts-node src/helper/extractFailedTests.ts",
    "chrome:test": "cross-env BROWSER=chrome_latest npm run test",
    "firefox:test": "cross-env BROWSER=firefox npm run test",
    "safari:test": "cross-env BROWSER=Safari npm run test",
    "parallelCrossBrowser": "concurrently \"npm run chrome:test\" \"npm run firefox:test\" \"npm run safari:test\"",
    "sonar": "sonar-scanner",
    "postinstall": "patch-package"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "e2e",
    "testing",
    "automation",
    "bdd"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.0.0",
    "@eslint/eslintrc": "^2.1.4",
    "@lambdatest/node-tunnel": "^4.0.8",
    "@playwright/test": "^1.52.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "cucumber-tsflow": "^4.5.2",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "fast-check": "^3.15.0",
    "fs-extra": "^11.2.0",
    "jest": "^29.7.0",
    "joi": "18.2.1",
    "multiple-cucumber-html-reporter": "^3.6.2",
    "patch-package": "^8.0.0",
    "sonar-scanner": "^3.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "winston": "^3.13.0"
  },
  "dependencies": {
    "eslint-import-resolver-typescript": "^3.6.1"
  }
}
